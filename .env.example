# Supabase (Auth + client API)
# Local: ./scripts/setup.sh maps supabase status → these keys
# Hosted: Project Settings → API (Project URL, anon key, service_role key)
#         or op://Frontenac Studios/Supabase <Project>/...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Drizzle — server-side Postgres connection string)
# Local: setup.sh maps DB_URL from `npm run supabase -- status -o env` → DATABASE_URL
# Hosted: dashboard → Connect → Transaction pooler (port 6543); replace [YOUR-PASSWORD]
#         with database password (Settings → Database → Reset database password)
# Example: postgresql://postgres.[ref]:[password]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# OpenRouter — server-only. Routes every AI call (chat companion, focus narration,
# EoD/EoW reviews, nudges, task categorization, cluster naming) through OpenRouter.
OPENROUTER_API_KEY=
# Optional model override (default: anthropic/claude-sonnet-5). Any OpenRouter slug works —
# e.g. z-ai/glm-4.7, openai/gpt-5.1, google/gemini-2.5-flash — swap it to change the model
# app-wide.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Optional per-task model tiers. Each falls back to OPENROUTER_MODEL when unset, so set only
# the ones you want to differ — e.g. a cheap model for high-volume work, a stronger one for the
# JSON paths.
#   _CHAT       → interactive companion (streaming + tool calling)
#   _STRUCTURED → JSON generators (week draft, EoD/EoW reviews, reflection beat)
#   _FAST       → cheap/high-volume/short (narration, nudges, category inference, cluster names)
# OPENROUTER_MODEL_CHAT=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_STRUCTURED=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_FAST=z-ai/glm-4.7
# Optional: enable the bingo-goals AI coach (off by default). Requires OPENROUTER_API_KEY.
# KASH_BINGO_COACH_ENABLED=1

# Proactive Top-3 nudges — optional dev overrides (default threshold: 2pm local)
# NUDGE_DEBUG_HOUR=12
# NEXT_PUBLIC_NUDGE_DEBUG_HOUR=12

# Desktop (Tauri macOS — local sidecar)
# DATABASE_MODE=sqlite
# KASH_DESKTOP=1
# KASH_DATA_DIR=~/Library/Application Support/com.frontenac.kash
# KASH_SIDECAR_PORT=4310
# CI desktop release (.github/workflows/release.yml) uses NEXT_PUBLIC_SUPABASE_* from GitHub secrets

# E2E (Playwright — local/CI only)
# E2E_USER_EMAIL=e2e@kash.test
# E2E_USER_PASSWORD=e2e-test-password-12!

# Sentry — Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Google Calendar sync — server-only (OAuth + sync engine)
# Desktop: register Authorized redirect URIs for
#   http://127.0.0.1:3000/api/calendar/google/callback  (desktop:dev)
#   http://127.0.0.1:4310/api/calendar/google/callback  (release sidecar)
# GOOGLE_CALENDAR_REDIRECT_URI is the default/fallback (Vercel + plain npm run dev).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Vercel cron auto-injects Authorization: Bearer ${CRON_SECRET} on scheduled invocations.
CRON_SECRET=
# Alias kept for local/manual cron calls (falls back if CRON_SECRET is unset).
CALENDAR_SYNC_CRON_SECRET=

# Source map upload (Vercel + CI only — never commit)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=frontenac-studios
# SENTRY_PROJECT=<your-sentry-project-slug>

# ---- Parked features (docs/v1-scope.md §3.2) ----
# Each defaults to OFF when unset. Set to "on" to un-park; requires a rebuild,
# because NEXT_PUBLIC_ values are inlined at build time.
# Care / garden — practices, garden scene, reflections. Data is preserved.
NEXT_PUBLIC_FLAG_CARE=
# Chat coach — per-page docks, the chat rail, /api/claude/*. Note that task
# creation falls back to the manual composer while this is off.
NEXT_PUBLIC_FLAG_CHAT=
# Focus mode — /today/focus. Parked pending the W2 timer.
NEXT_PUBLIC_FLAG_FOCUS=
# Google Calendar sync — api/calendar/* routes + Settings → Integrations tab.
# Data (connections + cached events) is preserved. Likeliest un-park in v1.1.
NEXT_PUBLIC_FLAG_CALENDAR=
